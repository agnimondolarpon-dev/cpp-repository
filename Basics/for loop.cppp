// For loop : Even number and Odd number 
// Author: Agni Mondol Arpon
#include <iostream>
using namespace std;

int main() {
    
   cout << "Even number 0 to 10" << "\n";
    
   for ( int e = 0 ; e < 11 ; e += 2) {
       cout << "\n" << e << "\n" ;
   }
   
   cout << "\nOdd number 0 to 10 \n ";
   
   for ( int o = 1 ; o < 10 ; o += 2 ) {
       cout << "\n" << o << "\n" ;
   }
   
}
    
